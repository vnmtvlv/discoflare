# Cloudflare resource selectors for the deployed sandbox. Copy this file to
# `.env.sandbox`, then fill it from the Cloudflare dashboard or Wrangler output.
# These values are required by `pnpm dev:sandbox`.
CLOUDFLARE_ACCOUNT_ID=
DISCOFLARE_SANDBOX_WORKER_NAME=
DISCOFLARE_SANDBOX_D1_DATABASE_NAME=
DISCOFLARE_SANDBOX_D1_DATABASE_ID=
DISCOFLARE_SANDBOX_R2_BUCKET_NAME=
DISCOFLARE_SANDBOX_KV_NAMESPACE_ID=

# Must match the AUTH_SECRET configured on the deployed sandbox so local
# requests and sandbox sessions use the same authentication configuration.
AUTH_SECRET=
AUTH_REGISTRATION_MODE=open

# Cloudflare Email Service sender used by the remote sandbox. The domain must be
# onboarded and the Worker must have an EMAIL send binding.
# EMAIL_FROM=login@sandbox.discoflare.com
# EMAIL_FROM_NAME=Discoflare Sandbox

# Optional local presentation overrides.
# APP_NAME=Discoflare Sandbox
# APP_TITLE=One workspace for humans, agents, and tasks.
# APP_SUBTITLE=Built on your Cloudflare stack.

# Optional X OAuth. Register the localhost callback separately before enabling:
# http://localhost:3000/api/auth/callback/twitter
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional Web Push. Generate one stable key pair with `pnpm vapid:generate`.
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional RealtimeKit huddles.
# REALTIMEKIT_ACCOUNT_ID=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_API_KEY=
# REALTIMEKIT_API_SECRET=
# REALTIMEKIT_PRESET_VOICE=voice
# REALTIMEKIT_PRESET_AV=group_call_host

# Do not put CLOUDFLARE_API_TOKEN, CLOUDFLARE_API_KEY, or CLOUDFLARE_EMAIL in
# this file. Use `wrangler login` or export a short-lived token in your shell.
