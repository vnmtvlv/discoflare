# Required. `pnpm env:init` generates this locally; enter a random 32+ character
# value in the Deploy to Cloudflare form.
AUTH_SECRET=replace-with-a-random-secret

# First-run owner. If both email and password are set and the database is empty,
# Discoflare creates the workspace and this account (no /setup form).
# The Deploy to Cloudflare form stores these as encrypted Worker secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin
# ADMIN_HANDLE=admin
# ADMIN_WORKSPACE=HQ

# Optional RealtimeKit huddles (server-only; use `wrangler secret put` in production)
# REALTIMEKIT_ACCOUNT_ID=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_API_KEY=
# REALTIMEKIT_API_SECRET=
# REALTIMEKIT_PRESET_VOICE=voice
# REALTIMEKIT_PRESET_AV=group_call_host
