# Better Auth (32+ chars). Use `wrangler secret put AUTH_SECRET` in production.
# AUTH_SECRET=

# First-run owner. If both email and password are set and the database is empty,
# Discoflare creates the workspace and this account (no /setup form).
# Copy to `.dev.vars` for local wrangler / nuxt cloudflare-dev.
# In production: `wrangler secret put ADMIN_PASSWORD` (and email/name as vars or secrets).
ADMIN_EMAIL=admin@discoflare.com
ADMIN_PASSWORD=password9293
ADMIN_NAME=Admin
# ADMIN_HANDLE=admin
# ADMIN_WORKSPACE=HQ

# Optional RealtimeKit huddles (server-only; use `wrangler secret put` in production)
# REALTIMEKIT_ACCOUNT_ID=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_API_KEY=
# REALTIMEKIT_API_SECRET=
# REALTIMEKIT_PRESET_VOICE=voice
# REALTIMEKIT_PRESET_AV=group_call_host
