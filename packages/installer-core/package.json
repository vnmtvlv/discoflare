{
  "name": "@discoflare/installer-core",
  "version": "0.8.2",
  "description": "Cloudflare provisioning engine shared by the Discoflare web installer and CLI",
  "type": "module",
  "license": "MIT",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
