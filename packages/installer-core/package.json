    "build": "tsc -p tsconfig.json",
    "pack:release": "pnpm build && pnpm pack --pack-destination ../../.installer/release"
  },
  "dependencies": {
    "cloudflare": "7.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
