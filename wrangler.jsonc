{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discoflare",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "ai": { "binding": "AI" },
  "workflows": [
    { "binding": "AGENT_TASK_WORKFLOW", "name": "discoflare-agent-tasks", "class_name": "AgentTaskWorkflow" },
    { "binding": "AGENT_MESSAGE_WORKFLOW", "name": "discoflare-agent-messages", "class_name": "AgentMessageWorkflow" }
  ],
  "containers": [
    { "class_name": "Sandbox", "image": "./Dockerfile.sandbox", "instance_type": "lite", "max_instances": 10 }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discoflare",
      "database_id": "REPLACE_ON_DEPLOY",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "discoflare-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TICKETS",
      "id": "REPLACE_ON_DEPLOY"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_DO", "class_name": "ChannelDurableObject" },
      { "name": "WORKSPACE_DO", "class_name": "WorkspaceDurableObject" },
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" },
      { "name": "NOTIFICATION_DO", "class_name": "NotificationDurableObject" },
      { "name": "AGENT_DO", "class_name": "DiscoflareAgent" },
      { "name": "AGENT_SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChannelDurableObject",
        "WorkspaceDurableObject",
        "RateLimitDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["NotificationDurableObject"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["DiscoflareAgent", "Sandbox"]
    }
  ],
  "vars": {
    "REALTIMEKIT_PRESET_VOICE": "voice",
    "REALTIMEKIT_PRESET_AV": "group_call_host",
    "AGENT_MODEL": "@cf/moonshotai/kimi-k2.7-code"
  }
}
