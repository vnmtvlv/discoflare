{
  "name": "@discoflare/com",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "nuxt build",
    "deploy": "node scripts/assert-workers-build.mjs && pnpm run db:migrate && wrangler deploy",
    "db:create": "wrangler d1 create discoflare-com-telemetry",
    "db:migrate": "node scripts/assert-workers-build.mjs && wrangler d1 migrations apply TELEMETRY_DB --remote",
    "dev": "nuxt dev",
    "generate": "nuxt generate --preset=static",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@discoflare/installer-core": "workspace:*",
    "@iconify-json/lucide": "^1.2.97",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/content": "^3.16.0",
    "@nuxt/ui": "^4.11.0",
    "cloudflare": "7.1.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.9.2",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.130.0"
  }
}
