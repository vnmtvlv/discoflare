{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discoflare-dev",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discoflare",
      "database_id": "local-discoflare",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "discoflare-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TICKETS",
      "id": "local-tickets"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_DO", "class_name": "ChannelDurableObject" },
      { "name": "WORKSPACE_DO", "class_name": "WorkspaceDurableObject" },
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChannelDurableObject",
        "WorkspaceDurableObject",
        "RateLimitDurableObject"
      ]
    }
  ]
}
