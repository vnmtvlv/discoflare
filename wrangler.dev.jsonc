{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discoflare-dev",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    { "binding": "AGENT_TASK_WORKFLOW", "name": "discoflare-agent-tasks-dev", "class_name": "AgentTaskWorkflow" },
    { "binding": "AGENT_MESSAGE_WORKFLOW", "name": "discoflare-agent-messages-dev", "class_name": "AgentMessageWorkflow" }
  ],
  "containers": [
    { "class_name": "Sandbox", "image": "./Dockerfile.sandbox", "instance_type": "lite", "max_instances": 3 }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discoflare",
      "database_id": "local-discoflare",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "discoflare-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TICKETS",
      "id": "local-tickets"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_DO", "class_name": "ChannelDurableObject" },
      { "name": "WORKSPACE_DO", "class_name": "WorkspaceDurableObject" },
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" },
      { "name": "NOTIFICATION_DO", "class_name": "NotificationDurableObject" },
      { "name": "AGENT_DO", "class_name": "DiscoflareAgent" },
      { "name": "AGENT_SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChannelDurableObject",
        "WorkspaceDurableObject",
        "RateLimitDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["NotificationDurableObject"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["DiscoflareAgent", "Sandbox"]
    }
  ],
  "vars": {
    "AGENT_MODEL": "@cf/moonshotai/kimi-k2.7-code"
  }
}
