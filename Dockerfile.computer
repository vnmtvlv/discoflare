FROM ghcr.io/cloudflare/computer-computerd-linux-x64:0.2.1 AS computerd

FROM debian:stable-slim

LABEL org.opencontainers.image.source="https://github.com/vnmtvlv/discoflare" \
      org.opencontainers.image.description="Discoflare Agent Computer runtime" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl fuse3 git gzip libfuse2t64 ripgrep tar \
    && rm -rf /var/lib/apt/lists/*

COPY --from=computerd /usr/local/bin/computerd /usr/local/bin/computerd

ENV PORT=8080
ENV MOUNT_POINT=/workspace
ENV FUSE_MOUNT=auto
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/computerd"]
